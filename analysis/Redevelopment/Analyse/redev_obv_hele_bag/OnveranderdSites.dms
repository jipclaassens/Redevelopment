// Potentiele-site-vorming voor de ONVERANDERDE woonvoorraad (issue #17), v2b 2026-07-17.
//
// Stage 2 van het paper vergelijkt herontwikkelde sites met niet-herontwikkelde; die laatste moeten met
// dezelfde vormingslogica tot 'sites' geclusterd worden als de waargenomen SN-sites (buffer 10m, wegen/
// spoor scheiden). Anders vergelijkt de binomiale logit multi-pand-projecten met losse panden.
//
// v2b — OPGEDEELD i.p.v. landelijke union: de v1-route (identiek aan AdditionalOperations/SN: inflate ->
// knip op weg/spoor -> geos_split_union_polygon landelijk) bleek op voorraadschaal (~4,6M panden) een
// single-threaded cross-tile-mergefase van >12 uur te hebben. v2b vermijdt elke landelijke union;
// alle stappen zijn getiled/parallel of gepartitioneerd:
//   1. inflate + knip op weg/spoor: exact de SN-expressies (dus cache-deling met eerdere runs);
//   2. geos_split_polygon: multiparts exploderen tot losse delen (geen union);
//   3. eigen-deel-filter: alleen het deel dat het EIGEN pand raakt doet mee (overlay delen x panden +
//      attribuutvergelijking) — voorkomt onterechte verbindingen via buffer-overspill over smalle wegen
//      (het werk dat in v1 de Cleaned-overlay en de split-union samen deden);
//   4. polygon_connectivity over de eigen-delen -> rakende paren; connected_parts (union-find) -> site
//      per pand; site-geometrie via gepartitioneerde geos_union_polygon per site.
// Semantisch equivalent aan v1 (zelfde 10m-nabijheid, zelfde weg/spoor-scheiding); verschillen alleen in
// maatnul-randgevallen (exact rakende buffers; pand volledig op wegvlak -> singleton-fallback in PrepDomains).
//
// Validatie (de vergelijkingsvraag in #17): VergelijkGrootte exporteert de site-groottedistributie van
// deze potentiele sites naast die van de gerealiseerde SN-sites. Een eventuele cap op mega-sites
// (aaneengesloten rijtjesblokken!) is een R-side besluit op basis van die vergelijking.
container OnveranderdSites
{
	unit<uint32> Bron := PrepBAG/BAG_Tabel/Onveranderd_Woon/uq // 1 rij per onveranderde woon-VBO
	{
		attribute<Panden> pand_rel := rlookup(pand_bag_nr, Panden/values);
		attribute<Sites>  Site_rel := Sites/part_rel[pand_rel];
	}

	unit<uint32> Panden := unique(Bron/pand_bag_nr)
	{
		attribute<uint64> pand_bag_nr      := values;
		attribute<Bron>   Bron_rel         := rlookup(pand_bag_nr, Bron/pand_bag_nr);
		attribute<rdc>    geometry  (poly) := Bron/pand_geometry[Bron_rel];
		attribute<m2>     area_pand        := area(geometry, m2);

		//buffer om de panden heen zodat aangrenzende voorraadpanden samenclusteren (zelfde parameter als SN)
		attribute<rdc>    inflate   (poly) := geos_buffer_multi_polygon(geometry, parameters/big_inflate_m[float64], 4b);

		//buffers geknipt op weg/spoor (exact de SN-expressie; TiledNonWegSpoor = niet-weg-multipolygon per tile)
		unit<uint32> PandenBuffer_x_WegSpoor := geos_overlay_polygon(inflate, SourceData/Grondgebruik/BRT/Read_Relevant_Tiles_x_WegSpoor/TiledNonWegSpoor);
	}

	//multiparts exploderen: losse aaneengesloten delen van de geknipte buffers.
	//LET OP: polygon_rel van geos_split_polygon is TILE-LOKAAL (gemeten 2026-07-17: 5,4M bronrecords,
	//max_polyrel 65535 = tilegrootte-1) en dus NIET bruikbaar als bronrij-relatie; de deel->pand-relatie
	//wordt daarom hieronder geometrisch gelegd.
	unit<uint32> Delen := geos_split_polygon(Panden/PandenBuffer_x_WegSpoor/geometry);

	//welke delen raken welk pand (first_rel -> Delen, second_rel -> Panden, geometry = intersectie)
	unit<uint32> Delen_x_Panden := geos_overlay_polygon(Delen/geometry, Panden/geometry);

	//eigen-deel-filter: een (deel, pand)-paar telt als het deel het pand vrijwel geheel bevat
	//(intersectie >= 50% van het pandoppervlak). Het eigen bufferdeel bevat zijn pand per constructie
	//(minus eventuele wegvlak-happen); overkant-van-de-weg-reepjes bevatten geen pand grotendeels en
	//vallen af — het werk dat in v1 de Cleaned-overlay en de split-union samen deden.
	unit<uint32> EigenDelen := select_with_org_rel(
		area(Delen_x_Panden/geometry, m2) >= 0.5d * Panden/area_pand[Delen_x_Panden/second_rel])
	{
		attribute<Delen>  deel_rel        := Delen_x_Panden/first_rel[org_rel];
		attribute<Panden> pand_rel        := Delen_x_Panden/second_rel[org_rel];
		attribute<rdc>    geometry (poly) := Delen/geometry[deel_rel];
	}

	//overlappende eigen-delen als getilde self-overlay (parallel; geen landelijke union).
	//NB: polygon_connectivity is hier bewust vermeden — die bleek op ~5M overlappende delen een
	//lang pagende single-threaded fase te hebben; de overlay-route bewees op deze schaal ~1 uur te kosten.
	//Semantiek: deel_p ∩ deel_q ≠ ∅ ⟺ pandafstand < 2x buffer (20m) binnen hetzelfde blok — identiek aan SN.
	unit<uint32> Adjacency := geos_overlay_polygon(EigenDelen/geometry, EigenDelen/geometry)
	{
		attribute<Panden> pand_F1 := EigenDelen/pand_rel[first_rel];
		attribute<Panden> pand_F2 := EigenDelen/pand_rel[second_rel];
	}

	//union-find over de pand-graaf: elke samenhangende groep panden is een potentiele site;
	//subitem part_rel (Panden) relateert elk pand aan zijn site
	unit<uint32> Sites := connected_parts(Adjacency/pand_F1, Adjacency/pand_F2)
	{
		attribute<string> Site_ID            := 'OnvS_'+string(id(.));

		attribute<rdc>    geometry    (poly) := geos_union_polygon(UnieInput/geometry, UnieInput/site_rel);
		attribute<m2>     site_size          := area(geometry, m2);
		attribute<m2>     site_sum_footprint := sum(Panden/area_pand, part_rel);
		attribute<uint32> n_panden           := pcount(part_rel);
		attribute<uint32> n_vbos             := pcount(Bron/Site_rel);
	}

	//invoer voor de gepartitioneerde site-union: eigen-delen plus de pandgeometrieen zelf
	unit<uint32> UnieInput := union_unit(EigenDelen, Panden)
	{
		attribute<rdc>   geometry (poly) := union_data(., EigenDelen/geometry, Panden/geometry);
		attribute<Sites> site_rel        := union_data(., Sites/part_rel[EigenDelen/pand_rel], Sites/part_rel);
	}

	//validatie #17: groottedistributie potentiele sites vs gerealiseerde SN-sites
	unit<uint32> VergelijkGrootte := union_unit(Sites, AdditionalOperations/SN/Result)
	, Descr = "1 rij per site (potentiele onveranderd-sites + gerealiseerde SN-sites) met omvang; tbv distributievergelijking in R"
	{
		attribute<string>  soort     := union_data(., const('Onveranderd_potentieel', Sites), const('SN_gerealiseerd', AdditionalOperations/SN/Result));
		attribute<float64> site_m2   := union_data(., Sites/site_size / 1[m2], AdditionalOperations/SN/Result/site_size / 1[m2]);
	}

	unit<uint32> VergelijkGrootte_Export := VergelijkGrootte
	, StorageName = "='%LocalDataProjDir%/Temp/OnveranderdSites_grootte_'+/Parameters/BAG_Selection_Area+'_'+/Parameters/BAG_file_date+'.csv'"
	, StorageType = "gdalwrite.vect"
	{
		attribute<string>  soort   := VergelijkGrootte/soort;
		attribute<float64> site_m2 := VergelijkGrootte/site_m2;
	}

	//kleinschalige operator-verificatie op de (gecachete) SN-sites: valideert polygon_connectivity/F1/F2,
	//geos_split_polygon/polygon_rel, connected_parts/part_rel en de rdc_cm-cast in minuten i.p.v. uren.
	container OperatorTest
	{
		unit<uint32> SplitTest := geos_split_polygon(AdditionalOperations/SN/Result/geometry_rd)
		{
			attribute<uint32> bron := polygon_rel[uint32];
		}
		unit<uint32> ConnTest := polygon_connectivity(AdditionalOperations/SN/Result/geometry_rd[rdc_cm]);
		unit<uint32> PartsTest := connected_parts(ConnTest/F1, ConnTest/F2);
		parameter<string> Resultaat := 'splitdelen;'+string(#SplitTest)+';connparen;'+string(#ConnTest)+';parts;'+string(#PartsTest)+';sites;'+string(#AdditionalOperations/SN/Result)
		, StorageName = "%LocalDataProjDir%/Temp/OnveranderdSites_OperatorTest.csv"
		, StorageType = "str";

		parameter<string> DiagnoseTellingen := 'panden;'+string(#Panden)+';delen;'+string(#Delen)+';delen_x_panden;'+string(#Delen_x_Panden)+';eigendelen;'+string(#EigenDelen)+';adjacency_paren;'+string(#Adjacency)+';sites;'+string(#Sites)
		, StorageName = "%LocalDataProjDir%/Temp/OnveranderdSites_DiagnoseTellingen.csv"
		, StorageType = "str";

		// beslist of polygon_rel een bronrij-verwijzing is (max ~ #overlay-records) of een part-nummer (max klein)
		parameter<string> DiagnosePolygonRel := 'n_overlay_records;'+string(#Panden/PandenBuffer_x_WegSpoor)
			+';n_delen;'+string(#Delen)
			+';min_polyrel;'+string(min(value(Delen/polygon_rel, uint32)))
			+';max_polyrel;'+string(max(value(Delen/polygon_rel, uint32)))
		, StorageName = "%LocalDataProjDir%/Temp/OnveranderdSites_DiagnosePolygonRel.csv"
		, StorageType = "str";
	}
}
